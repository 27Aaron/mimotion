# 数据库
DATABASE_URL=./data/mimotion.db

# 加密（32字节随机字符串，hex编码64字符）
ENCRYPTION_KEY=your-64-char-hex-encoded-32-bytes-key-here

# JWT（32字节随机字符串）
JWT_SECRET=your-64-char-hex-encoded-32-bytes-secret-here

# 初始管理员（仅首次迁移有效）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password

# 登录 Cookie：HTTPS 部署保持 true；仅在可信局域网通过 HTTP 访问时设为 false
AUTH_COOKIE_SECURE=true

# Rust Web 监听地址；使用专用变量以避免和系统 HOSTNAME 冲突
MIMOTION_HOST=0.0.0.0
# Web 监听端口
PORT=3000
# 调度器并发数
WORKER_CONCURRENCY=3
